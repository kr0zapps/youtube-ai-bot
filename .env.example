# =====================================================================
# YouTube AI Bot - Variables de Entorno de Ejemplo
# Copia este archivo a .env y rellena con tus credenciales reales
# =====================================================================

# Gemini API (gratis en https://aistudio.google.com)
GEMINI_API_KEY=tu_clave_aqui

# YouTube Data API v3 (gratis en https://console.cloud.google.com)
# Se usa OAuth2 con client_secrets.json descargado de Google Cloud Console
# El token de autenticación se guarda automáticamente en token.json tras el primer inicio de sesión
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json

# Reddit API (gratis en https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=tu_client_id
REDDIT_CLIENT_SECRET=tu_client_secret
REDDIT_USER_AGENT=youtube-ai-bot/1.0

# Canales YouTube (IDs o alias para referencia interna)
CHANNEL_MYSTERY=mystery
CHANNEL_NEWS=news
CHANNEL_REDDIT=reddit
