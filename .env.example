# =====================================================================
# YouTube AI Bot + GTA 6 Clipping Page — Variables de Entorno
# Copia este archivo a .env y completa con tus credenciales reales.
# NUNCA subas tu .env real a Git (ya está en .gitignore).
# =====================================================================

# ── IA / Generación de guiones ──────────────────────────────────────
# Gemini (gratis en https://aistudio.google.com)
GEMINI_API_KEY=tu_clave_gemini_aqui

# Groq — LLM de texto de alta velocidad (gratis en https://console.groq.com)
GROQ_API_KEY=tu_clave_groq_aqui

# ── YouTube Data API v3 ─────────────────────────────────────────────
# Archivo de secretos de cliente OAuth2 descargado de Google Cloud Console
# (APIs & Services > Credentials > OAuth 2.0 Client IDs > Desktop app)
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json

# ── TikTok ──────────────────────────────────────────────────────────
# Opción A: Access Token de la TikTok Content Posting API v2
TIKTOK_ACCESS_TOKEN=

# Opción B: Session ID de la web de TikTok (para upload vía cookies)
TIKTOK_SESSION_ID=

# ── Buffer (distribución multi-plataforma) ──────────────────────────
# Token de acceso de la Buffer API (https://buffer.com/developers/api)
BUFFER_ACCESS_TOKEN=

# IDs de los perfiles de Buffer donde publicar
# (encuéntralos en https://api.bufferapp.com/1/profiles.json?access_token=TU_TOKEN)
BUFFER_PROFILE_X=
BUFFER_PROFILE_IG=
BUFFER_PROFILE_TIKTOK=
BUFFER_PROFILE_YT=

# ── Reddit API (módulos legacy) ─────────────────────────────────────
# Crea tu app en https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=tu_client_id
REDDIT_CLIENT_SECRET=tu_client_secret
REDDIT_USER_AGENT=youtube-ai-bot/2.0

# ── Referencia de canales ──────────────────────────────────────────
CHANNEL_GTA6=gta6
CHANNEL_MYSTERY=mystery
CHANNEL_NEWS=news
CHANNEL_REDDIT=reddit
